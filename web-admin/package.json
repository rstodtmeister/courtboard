{
  "name": "courtboard-web-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc -b",
    "test:auth": "node --test tests/auth-session.test.mjs",
    "test:score": "node --test tests/score-save-order.test.mjs tests/score-outbox.test.mjs",
    "build": "tsc -b && vite build",
    "check": "npm run test:auth && npm run test:score && npm run test:display && npm run test:hvv && npm run test:protocols && npm run typecheck && npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "test:display": "node --test tests/display-loading.test.mjs",
    "test:hvv": "node --test tests/hvv-delivery.test.mjs",
    "test:protocols": "node --test tests/game-protocols.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.53.0",
    "@types/qrcode": "^1.5.6",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "typescript": "^5.8.3"
  }
}
